# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase Dashboard → Project Settings → API
#
# These are PUBLIC, browser-safe values (the anon key is protected by RLS).
# Never put the service_role key in here or anywhere in the client bundle.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
